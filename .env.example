# Roteamento pelo Traefik
DOMAIN=app.seudominio.com
APP_SCHEME=https
PORT=3003
TRAEFIK_NETWORK=traefik
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt
# Usado ao executar a aplicacao sem Docker. No Compose ele e derivado de
# APP_SCHEME e DOMAIN para evitar duplicacao.
APP_URL=https://app.seudominio.com

# Ambiente da aplicacao
ENVIRONMENT=production
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?pgbouncer=true
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Supabase
SUPABASE_URL=https://PROJECT.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=https://PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# IA
GEMINI_API_KEY=
GROQ_API_KEY=
GROQ_STT_MODEL=whisper-large-v3
GROQ_LLM_AUDIO_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
GROQ_LLM_SMART_MODEL=meta-llama/llama-4-maverick-17b-128e-instruct
OPENAI_API_KEY=
AI_CREDENTIALS_ENCRYPTION_KEY=

# Upstash QStash
QSTASH_URL=https://qstash.upstash.io
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
